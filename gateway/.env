# N0VA1O Production Environment Configuration
NODE_ENV=development
N0VA1O_HOST=0.0.0.0
N0VA1O_PORT=3001
N0VA1O_TRANSPORTS=http_sse,websocket

# Database (using existing PostgreSQL)
DATABASE_URL=postgresql://app:c3jMNOFZcyjgn2iFUHaCj5vs76zzNOqt@localhost:5432/n0va1o?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Encryption
N0VA1O_MASTER_KEY=n0va1o-production-master-key-256bit-secure

# OAuth Providers (fill in for production)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gateway URL
GATEWAY_PUBLIC_URL=http://localhost:3001

# Logging
LOG_LEVEL=info

# Audit
AUDIT_MERKLE_TREE=true
AUDIT_BLOCKCHAIN_ANCHIP=false
AUDIT_RETENTION_DAYS=365

# HITL
HITL_CRITICAL_TIMEOUT_HOURS=4
HITL_HIGH_TIMEOUT_HOURS=24
HITL_MEDIUM_TIMEOUT_HOURS=72
