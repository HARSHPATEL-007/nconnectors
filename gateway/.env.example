# N0VA1O Production Environment Configuration

# Server
NODE_ENV=production
N0VA1O_HOST=0.0.0.0
N0VA1O_PORT=3001
N0VA1O_TRANSPORTS=http_sse,websocket

# Database
DATABASE_URL=postgresql://n0va1o:n0va1o_secret@localhost:5432/n0va1o?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Encryption
N0VA1O_MASTER_KEY=change-this-to-a-secure-256-bit-key-in-production

# OAuth Providers
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gateway URL (used for OAuth callbacks)
GATEWAY_PUBLIC_URL=https://n0va1o.io

# Logging
LOG_LEVEL=info

# Audit
AUDIT_MERKLE_TREE=true
AUDIT_BLOCKCHAIN_ANCHIP=false
AUDIT_RETENTION_DAYS=365

# HITL
HITL_CRITICAL_TIMEOUT_HOURS=4
HITL_HIGH_TIMEOUT_HOURS=24
HITL_MEDIUM_TIMEOUT_HOURS=72
