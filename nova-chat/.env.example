# N0VA Chat Environment Configuration
# Copy this to .env and adjust for your deployment

# MongoDB
MONGO_INITDB_ROOT_USERNAME=nova
MONGO_INITDB_ROOT_PASSWORD=nova_password_2026_change_me
MONGO_INITDB_DATABASE=nova_chat

# Redis
REDIS_PASSWORD=nova_redis_2026_change_me

# Backend
JWT_SECRET=nova_chat_jwt_secret_change_in_production_min_32_chars
DATABASE_URL=mongodb://nova:nova_password_2026_change_me@mongodb:27017/nova_chat?authSource=admin
REDIS_URL=redis://:nova_redis_2026_change_me@redis:6379
AI_SERVICE_URL=http://ai-service:8000
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# AI Service
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu
